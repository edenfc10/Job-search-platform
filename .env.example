AIJAA_DATABASE_URL=sqlite+aiosqlite:///./aijaa_customer.db
AIJAA_ARTIFACTS_DIR=./artifacts
AIJAA_PUBLIC_BASE_URL=http://127.0.0.1:8000
AIJAA_PRODUCTION_MODE=true

# Production LLM mode
AIJAA_FAKE_LLM=false
AIJAA_LLM_PROVIDER=openai
AIJAA_OPENAI_API_KEY=sk-proj-replace-me
# Verify these against OpenAI's current model catalog before going live.
AIJAA_OPENAI_MODEL_FAST=gpt-4.1-mini
AIJAA_OPENAI_MODEL_SMART=gpt-4.1

# Real job sources. Use official public boards or manual URLs.
AIJAA_ENABLE_MANUAL_URLS=true
AIJAA_GREENHOUSE_ORGS=
AIJAA_LEVER_ORGS=

# Israeli boards require official feed/API/permission details before automation.
AIJAA_ISRAELI_PARTNER_SOURCES=
AIJAA_LINKEDIN_APPROVED_ACCESS=false

# Real forms require Playwright. The app still stops at ready_to_submit while
# AIJAA_DRY_RUN=true.
AIJAA_APPLY_DRIVER=playwright

# Safety default. Keep true until E2E and human review staffing are ready.
AIJAA_DRY_RUN=true
