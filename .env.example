# Local PostgreSQL and Redis services started by `docker compose up -d`.
# These credentials are development-only and must not be reused in production.
AIJAA_DATABASE_URL=postgresql+asyncpg://aijaa:aijaa-local@127.0.0.1:55432/aijaa
AIJAA_REDIS_URL=redis://127.0.0.1:6379/0
AIJAA_ARTIFACTS_DIR=./local_artifacts/postgres
AIJAA_PUBLIC_BASE_URL=http://127.0.0.1:8010
AIJAA_PRODUCTION_MODE=false
AIJAA_WORKFLOW_MODE=sync

# Safe local LLM mode. Set false only with a configured provider key.
AIJAA_FAKE_LLM=true
AIJAA_LLM_PROVIDER=openai
AIJAA_OPENAI_API_KEY=sk-proj-replace-me
# Verify these against OpenAI's current model catalog before going live.
AIJAA_OPENAI_MODEL_FAST=gpt-4.1-mini
AIJAA_OPENAI_MODEL_SMART=gpt-4.1

# Real job sources. Use official public boards or manual URLs.
AIJAA_ENABLE_MANUAL_URLS=true
AIJAA_GREENHOUSE_ORGS=
AIJAA_LEVER_ORGS=

# Israeli boards require official feed/API/permission details before automation.
AIJAA_ISRAELI_PARTNER_SOURCES=
AIJAA_LINKEDIN_APPROVED_ACCESS=false

# Use the deterministic HTTP driver locally. Production will require Playwright.
AIJAA_APPLY_DRIVER=http

# Safety default. Keep true until E2E and human review staffing are ready.
AIJAA_DRY_RUN=true
